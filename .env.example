# International format, digits only. Example: 15551234567
VITE_WHATSAPP_NUMBER=

# WhatsApp Cloud API backend
PORT=3000
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-value
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=

# Set this to the Graph API version shown in your Meta developer dashboard.
META_GRAPH_API_VERSION=v23.0
