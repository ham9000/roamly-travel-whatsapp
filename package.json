{
  "name": "roamly-travel-whatsapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:bot",
    "lint": "oxlint src server",
    "preview": "vite preview",
    "bot:dev": "tsx watch server/index.ts",
    "bot:simulate": "tsx server/simulator.ts",
    "bot:start": "node dist-server/index.js",
    "test": "tsx --test server/**/*.test.ts",
    "build:web": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:bot": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
